# EduNexus AI Environment Configuration

# Server Settings
PROJECT_NAME="EduNexus AI"
API_V1_STR="/api"
PORT=8000

# Database Configuration (defaults to SQLite in backend/data/edunexus.db)
DATABASE_URL="sqlite:///backend/data/edunexus.db"

# LLM & Embedding Provider Options: "demo" (default offline), "gemini", "openai"
DEFAULT_LLM_PROVIDER="demo"

# Optional External API Keys (Leave blank for offline/demo mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Bayesian Knowledge Tracing Default Hyperparameters
BKT_DEFAULT_P_L0=0.20
BKT_DEFAULT_P_T=0.15
BKT_DEFAULT_P_G=0.25
BKT_DEFAULT_P_S=0.10
